# Production Docker Compose template
# Copy this file to .env on the server and replace every placeholder value.

# ---------- Image tags ----------
DOCKERHUB_NAMESPACE=your-dockerhub-namespace
IMAGE_TAG=2026.05.12
BACKEND_IMAGE=your-dockerhub-namespace/learning-assistant-backend:2026.05.12
FRONTEND_IMAGE=your-dockerhub-namespace/learning-assistant-frontend:2026.05.12

# ---------- Published local ports ----------
# Keep these bound to 127.0.0.1 and put HTTPS reverse proxy in front of frontend.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# ---------- PostgreSQL / PGVector ----------
POSTGRES_DB=learning_assistant
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://learning_user:replace-with-a-strong-postgres-password@postgres:5432/learning_assistant
LANGGRAPH_POSTGRES_URL=postgresql://learning_user:replace-with-a-strong-postgres-password@postgres:5432/learning_assistant
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
RUN_ALEMBIC_UPGRADE=true
PGVECTOR_COLLECTION_PREFIX=learning
PGVECTOR_DEFAULT_COLLECTION=learning_docs
PGVECTOR_EMBEDDING_DIMENSION=3072
PGVECTOR_DISTANCE_STRATEGY=cosine

# ---------- App runtime ----------
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=https://your-domain.example
AUTH_COOKIE_SECURE=true
JWT_SECRET_KEY=replace-with-a-32-byte-or-longer-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_CODE_SECRET=
AUTH_REGISTER_CODE_IP_WINDOW_SECONDS=60
AUTH_REGISTER_CODE_IP_MAX_REQUESTS=20
AUTH_WECHAT_LOGIN_IP_WINDOW_SECONDS=60
AUTH_WECHAT_LOGIN_IP_MAX_REQUESTS=30
# Comma-separated trusted reverse proxy IPs/CIDRs. Leave empty to ignore X-Forwarded-For/X-Real-IP.
AUTH_TRUSTED_PROXY_IPS=
WECHAT_MINI_APP_ID=replace-with-wechat-mini-app-id
WECHAT_MINI_APP_SECRET=replace-with-wechat-mini-app-secret
ENABLE_GRAPH_FACTS=true
ENABLE_GRAPH_DUAL_WRITE=false
ENABLE_PRACTICE_FINALIZER_WORKER=true
PRACTICE_FINALIZER_WORKER_INTERVAL_SECONDS=30
PRACTICE_FINALIZER_WORKER_LIMIT=20

# ---------- Frontend proxy ----------
INTERNAL_API_BASE=http://backend:8000/api
NEXT_PUBLIC_API_BASE=/api
NEXT_TELEMETRY_DISABLED=1

# ---------- Chat model ----------
MODEL_ACCESS_KEY=replace-with-model-access-key
# Optional alias. Leave blank when MODEL_ACCESS_KEY is set; the backend will align it at startup.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
LOCKED_CHAT_MODEL=deepseek-v4-pro
FALLBACK_CHAT_MODEL=deepseek-v4-flash
MODEL_SWITCHING_ENABLED=false
PRACTICE_GENERATION_MODEL=deepseek-v4-flash
PRACTICE_GENERATION_TIMEOUT_SECONDS=6
PRACTICE_REPAIR_TIMEOUT_SECONDS=4
PRACTICE_RECOMMENDATION_LIVE_AI=false

# ---------- Embedding ----------
EMBEDDING_PROVIDER=google
GOOGLE_API_KEYS=replace-with-google-api-key
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# ---------- Optional NVIDIA model ----------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GLM_MODEL=z-ai/glm4.7
NVIDIA_ENABLE_TOOL_CALLING=false
NVIDIA_ENABLE_STRUCTURED_OUTPUT=false

# ---------- Optional SMTP for registration emails ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Learning Assistant"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---------- Optional LangSmith tracing ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=learning-assistant
LANGSMITH_ENDPOINT=
GRAPH_EVAL_LANGSMITH=false
GRAPH_EVAL_DATASET=learning-assistant-graph-smoke

# ---------- Optional external MCP tools ----------
MCP_ENABLED=false
MCP_TRANSPORT=http
MCP_WEB_SERVER_URL=
MCP_WEB_SEARCH_TOOL=web_search
MCP_WEB_READ_TOOL=web_read
MCP_REQUEST_TIMEOUT_SECONDS=15
MCP_MAX_RESULTS=5

# ---------- Optional web search fallback ----------
TAVILY_API_KEY=

# ---------- PDF chunking ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
