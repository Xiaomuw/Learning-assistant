# Docker Compose local defaults
# ------------------------------------------------------------
# docker-compose.yml uses the same values for:
# - postgres POSTGRES_* initialization
# - backend DATABASE_URL
# - backend LANGGRAPH_POSTGRES_URL
# - postgres healthcheck
#
# If you already have an existing postgres_data Docker volume initialized with
# another role, set POSTGRES_USER/POSTGRES_PASSWORD here to that existing role,
# or manually create/grant the role inside PostgreSQL. Changing POSTGRES_USER
# does not recreate roles inside an existing volume.

POSTGRES_DB=learning_assistant
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=learning_password

# Example for reusing a local volume initialized with your macOS/Postgres role:
# POSTGRES_USER=xiaomu
# POSTGRES_PASSWORD=123456
