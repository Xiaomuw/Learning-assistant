# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================

# ---------- DigitalOcean Model Access ----------
# 官方 SDK 使用 MODEL_ACCESS_KEY；LangChain / OpenAI 兼容调用会自动复用它
MODEL_ACCESS_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=${MODEL_ACCESS_KEY}
OPENAI_BASE_URL=https://inference.do-ai.run/v1
OPENAI_MODEL=openai-gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Chroma ----------
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=learning_docs

# ---------- Database ----------
# 本机直接运行后端时：
# DATABASE_URL=mysql+pymysql://learning_user:password@127.0.0.1:3307/learning_assistant?charset=utf8mb4
# 后端跑在 Docker 容器里、MySQL 单独跑在 Docker Desktop 时：
# DATABASE_URL=mysql+pymysql://learning_user:password@host.docker.internal:3307/learning_assistant?charset=utf8mb4
DATABASE_URL=mysql+pymysql://learning_user:password@host.docker.internal:3307/learning_assistant?charset=utf8mb4

# ---------- 应用配置 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=DEBUG

# ---------- PDF 分块 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
