# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 说明：
#   1. 正式运行时只支持 PostgreSQL + PGVector
#   2. 本机运行使用 127.0.0.1:5432
#   3. Docker Compose 会覆盖为 postgres:5432
# ============================================================

# ---------- DeepSeek Model Access ----------
# 真实密钥只放本地 backend/.env，不要提交。
MODEL_ACCESS_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=${MODEL_ACCESS_KEY}
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
LOCKED_CHAT_MODEL=deepseek-v4-pro
FALLBACK_CHAT_MODEL=deepseek-v4-flash
MODEL_SWITCHING_ENABLED=false
# DeepSeek V4 当前不走 LangChain 原生 json_schema parse；应用会使用 JSON prompt + 本地 Pydantic 校验。

# ---------- Practice Generation ----------
# 问答质量优先使用 deepseek-v4-pro；刷题/补题速度优先默认使用 flash，并限制超时。
PRACTICE_GENERATION_MODEL=deepseek-v4-flash
PRACTICE_GENERATION_TIMEOUT_SECONDS=6
PRACTICE_REPAIR_TIMEOUT_SECONDS=4
# 推荐题默认不触发实时模型，避免页面加载被外部模型超时拖慢。
PRACTICE_RECOMMENDATION_LIVE_AI=false

# ---------- Embedding ----------
# DeepSeek V4 是聊天模型；向量化默认继续使用 Google，或显式配置独立 OpenAI-compatible embedding provider。
EMBEDDING_PROVIDER=google
GOOGLE_API_KEYS=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 可选：当 EMBEDDING_PROVIDER=openai-compatible 时使用独立 embedding endpoint。
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# ---------- NVIDIA NIM Model Access ----------
# 用于第二聊天模型 GLM-4.7。真实密钥只放本地 backend/.env，不要提交。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GLM_MODEL=z-ai/glm4.7
# 当前应用默认关闭 NVIDIA 工具/结构化调用，避免 provider 兼容性超时；确认稳定后可显式开启。
NVIDIA_ENABLE_TOOL_CALLING=false
NVIDIA_ENABLE_STRUCTURED_OUTPUT=false

# ---------- Database（启动级必需） ----------
# 本机直接运行后端并连接本机 PostgreSQL 时，通常是 5432：
# DATABASE_URL=postgresql+psycopg://learning_user:password@127.0.0.1:5432/learning_assistant
# 本机直接运行后端并连接 docker-compose 暴露的 PostgreSQL 时，默认是 5433：
# DATABASE_URL=postgresql+psycopg://learning_user:password@127.0.0.1:5433/learning_assistant
# Docker Compose 内部网络：
# DATABASE_URL=postgresql+psycopg://learning_user:password@postgres:5432/learning_assistant
DATABASE_URL=postgresql+psycopg://learning_user:password@127.0.0.1:5432/learning_assistant

# ---------- LangGraph / PGVector ----------
# 可选：若不填，运行时会从 DATABASE_URL 自动推导
# 本机直连 docker-compose PostgreSQL 时可使用 5433：
# LANGGRAPH_POSTGRES_URL=postgresql://learning_user:password@127.0.0.1:5433/learning_assistant
LANGGRAPH_POSTGRES_URL=postgresql://learning_user:password@127.0.0.1:5432/learning_assistant
PGVECTOR_COLLECTION_PREFIX=learning
PGVECTOR_DEFAULT_COLLECTION=learning_docs
# 示例值需与实际 embedding 模型输出维度一致；维度或距离策略变更后需重建已有 collection。
PGVECTOR_EMBEDDING_DIMENSION=3072
PGVECTOR_DISTANCE_STRATEGY=cosine

# ---------- LangSmith ----------
# 开发/排障时可开启主问答链路 tracing；关闭或未配置时会自动降级，不影响业务运行
# 后端会记录完整用户问题、工具/检索/模型摘要与最终答案；notebook/记忆正文会摘要脱敏。
# 原始 reasoning_content / chain-of-thought 不会发送到 LangSmith，只记录安全推理摘要。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=learning-assistant
# LangSmith Cloud 默认可留空；如有私有部署或代理地址，再填写
LANGSMITH_ENDPOINT=
GRAPH_EVAL_LANGSMITH=false
GRAPH_EVAL_DATASET=learning-assistant-graph-smoke

# ---------- Enterprise Graph Runtime ----------
# /api/chat 默认使用 LearningOrchestratorGraph。
# facts 默认开启；如本地只想跑无数据库 contract 测试，可临时设置 ENABLE_GRAPH_FACTS=false。
ENABLE_GRAPH_FACTS=true
ENABLE_GRAPH_DUAL_WRITE=false
# practice attempts 使用 durable finalizer job；生产开启 graph-era facts / dual write 时建议开启轻量 worker。
ENABLE_PRACTICE_FINALIZER_WORKER=true
PRACTICE_FINALIZER_WORKER_INTERVAL_SECONDS=30
PRACTICE_FINALIZER_WORKER_LIMIT=20

# ---------- External MCP ----------
# V1 仅支持 HTTP MCP，用于主问答链路的网页搜索 / 网页读取增强。
MCP_ENABLED=false
MCP_TRANSPORT=http
MCP_WEB_SERVER_URL=
MCP_WEB_SEARCH_TOOL=web_search
MCP_WEB_READ_TOOL=web_read
MCP_REQUEST_TIMEOUT_SECONDS=15
MCP_MAX_RESULTS=5

# ---------- 应用配置 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ALLOW_ORIGINS=*

# ---------- Auth（启动级必需） ----------
# 生产环境请替换为长度足够的随机密钥；若仍为占位值，后端会拒绝启动
# APP_ENV=production 时必须设置 AUTH_COOKIE_SECURE=true，且 CORS_ALLOW_ORIGINS 不能为 *
JWT_SECRET_KEY=replace-with-a-32-byte-or-longer-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_CODE_SECRET=
AUTH_REGISTER_CODE_IP_WINDOW_SECONDS=60
AUTH_REGISTER_CODE_IP_MAX_REQUESTS=20
AUTH_WECHAT_LOGIN_IP_WINDOW_SECONDS=60
AUTH_WECHAT_LOGIN_IP_MAX_REQUESTS=30
# 反向代理可信来源，留空时忽略 X-Forwarded-For / X-Real-IP，避免伪造客户端 IP。
AUTH_TRUSTED_PROXY_IPS=

# ---------- 微信小程序登录 ----------
# 真实 AppSecret 只放 backend/.env，不要提交；APP_ENV=production 时缺失会拒绝启动。
WECHAT_MINI_APP_ID=replace-with-wechat-mini-app-id
WECHAT_MINI_APP_SECRET=replace-with-wechat-mini-app-secret

# ---------- SMTP（注册验证码能力级必需） ----------
# 用于注册时发送邮箱验证码；未配置时服务仍可启动，但 /api/auth/register/send-code 会直接报错
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Learning Assistant"
SMTP_USE_TLS=true

# ---------- 运行级排障 ----------
# 模型密钥缺失：后端可启动，但主问答无法真正调用模型
# SMTP 缺失：注册发码接口不可用
# LangSmith / MCP 缺失：只会自动降级，不影响主链路启动

# ---------- PDF 分块 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------- Tavily 网络搜索（知识库回退）----------
# 免费注册：https://tavily.com
TAVILY_API_KEY=
