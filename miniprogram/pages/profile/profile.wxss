.profile-page { display: flex; flex-direction: column; height: 100vh; background: var(--neo-bg); }

/* ─── Header ─── */
.profile-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--neo-secondary);
  border-bottom: 3px solid var(--neo-ink);
  padding: 16px;
  text-align: center;
}

.profile-header-title {
  font-size: 18px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.16em;
}

/* ─── Notice ─── */
.notice-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 3px solid var(--neo-ink);
  animation: stampIn 0.2s ease-out;
}
.notice-success { background: var(--neo-green); }
.notice-error { background: var(--neo-accent); }
.notice-info { background: var(--neo-muted); }
.notice-text { font-size: 14px; font-weight: 700; flex: 1; }
.notice-close {
  font-size: 16px;
  padding: 4px 8px;
  font-weight: 900;
  border: 2px solid var(--neo-ink);
  border-radius: 999px;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ─── Scroll ─── */
.profile-scroll { flex: 1; padding: 16px; }

/* ─── User Card ─── */
.user-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  background: var(--neo-white);
  margin-bottom: 16px;
}

.avatar-wrap {
  width: 64px;
  height: 64px;
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  background: var(--neo-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  flex-shrink: 0;
  box-shadow: 2px 3px 0px 0px var(--neo-ink);
}
.avatar-icon { font-size: 30px; }

.user-info { flex: 1; min-width: 0; }
.user-name { font-size: 18px; font-weight: 900; display: block; overflow: hidden; text-overflow: ellipsis; }
.user-id { font-size: 11px; font-weight: 700; opacity: 0.5; display: block; margin-top: 4px; }
.user-email { font-size: 12px; font-weight: 700; opacity: 0.6; display: block; }
.user-style { font-size: 12px; font-weight: 700; opacity: 0.7; display: block; margin-top: 4px; }

/* ─── Stats Row ─── */
.stats-row { display: flex; gap: 12px; margin-bottom: 16px; }
.stat-cell {
  flex: 1;
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  padding: 16px;
  text-align: center;
  box-shadow: var(--shadow-md);
}
.stat-num { font-size: 34px; font-weight: 900; display: block; }
.stat-key {
  font-size: 11px;
  font-weight: 900;
  opacity: 0.6;
  display: block;
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

/* ─── Sections ─── */
.section-card { background: var(--neo-white); padding: 18px; margin-bottom: 16px; }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.section-title { font-size: 20px; font-weight: 900; display: block; margin-top: 4px; }
.section-desc { font-size: 13px; font-weight: 700; opacity: 0.7; display: block; margin-top: 4px; line-height: 1.5; }

.badge-num {
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background: var(--neo-secondary);
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 2px 2px 0px 0px var(--neo-ink);
  flex-shrink: 0;
}

.toggle-arrow {
  font-size: 18px;
  font-weight: 900;
  padding: 8px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--neo-bg);
  box-shadow: 2px 2px 0px 0px var(--neo-ink);
  flex-shrink: 0;
  transition: transform 100ms linear, box-shadow 100ms linear;
}
.toggle-arrow:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

.empty-hint {
  border: 3px dashed rgba(30, 41, 59, 0.3);
  border-radius: 24rpx;
  padding: 16px;
  margin-top: 12px;
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 41, 59, 0.6);
  line-height: 1.5;
}

/* ─── Quiz Preview ─── */
.quiz-preview {
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  padding: 14px;
  background: var(--neo-bg);
  margin-top: 12px;
  box-shadow: 2px 3px 0px 0px var(--neo-ink);
}
.quiz-badges { display: flex; gap: 6px; margin-bottom: 8px; }
.q-badge {
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 10px;
  font-weight: 900;
  box-shadow: 1px 1px 0px 0px var(--neo-ink);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.q-badge-accent { background: var(--neo-accent); }
.q-badge-secondary { background: var(--neo-secondary); }
.quiz-q { font-size: 13px; font-weight: 900; line-height: 1.5; display: block; }

/* ─── Notebooks ─── */
.notebook-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 2px solid rgba(30, 41, 59, 0.1);
}
.notebook-row:last-child { border-bottom: none; }
.nb-icon { font-size: 22px; flex-shrink: 0; }
.notebook-info { flex: 1; min-width: 0; }
.nb-name { font-size: 14px; font-weight: 900; display: block; }
.nb-desc { font-size: 12px; font-weight: 700; opacity: 0.6; display: block; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; }
.nb-count {
  font-size: 12px;
  font-weight: 900;
  opacity: 0.5;
  border: 2px solid rgba(30, 41, 59, 0.3);
  border-radius: 999px;
  padding: 2px 8px;
}

/* ─── Sessions ─── */
.session-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 2px solid rgba(30, 41, 59, 0.1);
}
.session-row:last-child { border-bottom: none; }
.session-info { flex: 1; min-width: 0; }
.session-title { font-size: 14px; font-weight: 700; display: block; overflow: hidden; text-overflow: ellipsis; }
.session-meta { font-size: 11px; font-weight: 700; opacity: 0.5; display: block; margin-top: 2px; }
.del-btn {
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  padding: 8px;
  background: var(--neo-accent);
  box-shadow: 2px 2px 0px 0px var(--neo-ink);
  font-size: 14px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 100ms linear, box-shadow 100ms linear;
}
.del-btn:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

/* ─── Security Form ─── */
.security-form { display: flex; flex-direction: column; gap: 14px; margin-top: 16px; }
.field-group { display: flex; flex-direction: column; gap: 6px; }

/* ─── Logout ─── */
.logout-btn {
  background: var(--neo-error);
  color: var(--neo-white);
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  box-shadow: var(--shadow-md);
  padding: 16px;
  text-align: center;
  font-size: 15px;
  font-weight: 900;
  letter-spacing: 0.1em;
  margin-bottom: 40px;
  transition: transform 100ms linear, box-shadow 100ms linear;
}
.logout-btn:active {
  transform: translate(4px, 4px);
  box-shadow: none;
}

/* ─── Edit Profile Modal ─── */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.modal-card {
  background: var(--neo-white);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  width: 100%;
}
.modal-title { font-size: 22px; font-weight: 900; }
.modal-actions { display: flex; gap: 12px; }

/* ─── State ─── */
.center-state { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
.state-card { padding: 24px; background: var(--neo-white); }
.state-title { font-size: 22px; font-weight: 900; display: block; margin-top: 8px; }
