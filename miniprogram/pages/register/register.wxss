@import "../login/login.wxss";

/* Step indicator */
.step-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  margin-bottom: 4px;
}
.step-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 32px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  font-weight: 900;
  font-size: 12px;
  padding: 0 6px;
}
.step-active-secondary { background: var(--neo-secondary); }
.step-active-muted { background: var(--neo-muted); }
.step-done { background: var(--neo-ink); color: #fff; }
.step-inactive { background: #fff; }
.step-label { font-size: 11px; }
.step-sep { color: rgba(30,30,36,0.3); }
.text-muted { color: rgba(30,30,36,0.4); }

/* Email info card */
.email-card {
  border: 3px solid var(--neo-ink);
  border-radius: 20px;
  background: var(--neo-secondary);
  padding: 12px 16px;
  box-shadow: 3px 3px 0px var(--neo-ink);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.email-card-body { flex: 1; }
.email-address { font-size: 15px; font-weight: 900; }
.email-hint { margin-top: 4px; font-size: 12px; font-weight: 700; color: rgba(30,30,36,0.6); }
.change-btn {
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background: #fff;
  padding: 4px 12px;
  font-size: 11px;
  font-weight: 900;
  box-shadow: 2px 2px 0px var(--neo-ink);
  white-space: nowrap;
}

/* Resend */
.resend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 8px;
}
.resend-tip { font-size: 11px; font-weight: 700; color: rgba(30,30,36,0.5); flex: 1; }
.resend-btn {
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background: #fff;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 900;
  box-shadow: 2px 2px 0px var(--neo-ink);
}

/* Password strength */
.strength-wrap { margin-top: 8px; }
.strength-bars { display: flex; gap: 4px; margin-bottom: 4px; }
.strength-bar { flex: 1; height: 6px; border-radius: 999px; border: 1px solid rgba(30,30,36,0.2); }
.bar-filled { }
.bar-empty { background: rgba(30,30,36,0.1); }
.strength-label { font-size: 10px; font-weight: 700; color: rgba(30,30,36,0.5); }

/* Match / mismatch */
.match-badge {
  display: inline-block;
  background: #69f0ae;
  border-radius: 999px;
  padding: 2px 8px;
  font-size: 10px;
  font-weight: 900;
  margin-left: 6px;
}
.mismatch-text {
  margin-top: 4px;
  font-size: 12px;
  font-weight: 700;
  color: var(--neo-accent);
}

/* Success */
.success-box {
  border: 3px solid var(--neo-ink);
  border-radius: 20px;
  background: #69f0ae;
  padding: 12px 16px;
  box-shadow: 3px 3px 0px var(--neo-ink);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.5;
}

/* Login hint card */
.login-hint-card {
  border: 3px dashed var(--neo-ink);
  border-radius: 20px;
  background: var(--neo-bg);
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.login-hint-text { font-size: 13px; font-weight: 700; color: rgba(30,30,36,0.7); margin-top: 4px; line-height: 1.5; }
.ghost-btn-sm {
  border: 3px solid var(--neo-ink);
  border-radius: 8px;
  background: var(--neo-secondary);
  padding: 10px 14px;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 3px 3px 0px var(--neo-ink);
  white-space: nowrap;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
