@import "../login/login.wxss";

/* ─── Step Indicator ─── */
.step-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  margin-bottom: 4px;
}

.step-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34px;
  height: 34px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  font-weight: 900;
  font-size: 13px;
  padding: 0 6px;
  box-shadow: 2px 2px 0px 0px var(--neo-ink);
}

.step-active-secondary { background: var(--neo-secondary); }
.step-active-muted { background: var(--neo-muted); }
.step-done { background: var(--neo-ink); color: #fff; }
.step-inactive { background: var(--neo-white); }
.step-label { font-size: 11px; font-weight: 900; }
.step-sep { color: rgba(30, 41, 59, 0.3); font-weight: 900; }

/* ─── Email Info Card ─── */
.email-card {
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  background: var(--neo-secondary);
  padding: 14px 16px;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.email-card-body { flex: 1; }
.email-address { font-size: 15px; font-weight: 900; }
.email-hint { margin-top: 4px; font-size: 12px; font-weight: 700; color: rgba(30, 41, 59, 0.6); }

/* ─── Resend ─── */
.resend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 8px;
}
.resend-tip { font-size: 11px; font-weight: 700; color: rgba(30, 41, 59, 0.5); flex: 1; }

/* ─── Password Strength ─── */
.strength-wrap { margin-top: 10px; }
.strength-bars { display: flex; gap: 4px; margin-bottom: 4px; }
.strength-bar {
  flex: 1;
  height: 8px;
  border-radius: 999px;
  border: 2px solid rgba(30, 41, 59, 0.2);
}
.bar-filled { }
.bar-empty { background: rgba(30, 41, 59, 0.08); }
.strength-label { font-size: 10px; font-weight: 700; color: rgba(30, 41, 59, 0.5); }

/* ─── Match / Mismatch ─── */
.match-badge {
  display: inline-block;
  background: var(--neo-green);
  border: 2px solid var(--neo-ink);
  border-radius: 999px;
  padding: 2px 10px;
  font-size: 10px;
  font-weight: 900;
  margin-left: 6px;
  letter-spacing: 0;
}

.mismatch-text {
  margin-top: 6px;
  font-size: 12px;
  font-weight: 700;
  color: var(--neo-error);
}

/* ─── Login Hint Card ─── */
.login-hint-card {
  border: 3px dashed var(--neo-ink);
  border-radius: 24rpx;
  background: var(--neo-bg);
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.login-hint-text {
  font-size: 13px;
  font-weight: 700;
  color: rgba(30, 41, 59, 0.7);
  margin-top: 4px;
  line-height: 1.5;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
