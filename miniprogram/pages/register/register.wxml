<view class="page-bg">
  <!-- Hero Banner -->
  <view class="hero bg-muted">
    <text class="hero-deco hero-deco-r animate-float-tag">✉️</text>
    <text class="hero-deco hero-deco-l animate-float-tag" style="animation-delay: 1s;">🔐</text>

    <view class="hero-inner">
      <view class="neo-badge mb-3">
        <text>✦</text>
        <text class="neo-badge-text">邮箱注册</text>
      </view>
      <view class="hero-title">先验证邮箱，再创建账号</view>
      <view class="hero-subtitle">验证码发送到你的邮箱，校验通过后才会真正注册成功</view>
    </view>
  </view>

  <view class="form-section">
    <view class="neo-box form-card">
      <!-- Step Indicator -->
      <view class="step-row">
        <view class="step-dot {{step === 'email' ? 'step-active-secondary' : 'step-done'}}">
          <text>1</text>
        </view>
        <text class="step-label {{step === 'email' ? '' : 'text-ink-50'}}">发送验证码</text>
        <text class="step-sep">／</text>
        <view class="step-dot {{step === 'complete' ? 'step-active-muted' : 'step-inactive'}}">
          <text>2</text>
        </view>
        <text class="step-label {{step === 'complete' ? '' : 'text-ink-50'}}">完成注册</text>
      </view>

      <!-- Step 1: Email -->
      <block wx:if="{{step === 'email'}}">
        <view class="field-group">
          <view class="neo-label flex items-center gap-2 mb-1">📧 邮箱地址</view>
          <input class="neo-input" type="text" placeholder="you@example.com" data-field="email" bindinput="onInput" value="{{email}}"/>
        </view>
        <view class="neo-btn w-full text-center {{isSendingCode ? 'btn-disabled' : ''}}" bindtap="handleSendCode">
          <text>{{isSendingCode ? '正在发送…' : '发送验证码 →'}}</text>
        </view>
      </block>

      <!-- Step 2: Complete -->
      <block wx:else>
        <!-- Email info card -->
        <view class="email-card">
          <view class="email-card-body">
            <view class="neo-label" style="margin-bottom:4px;">验证邮箱</view>
            <view class="email-address">{{email}}</view>
            <view class="email-hint">验证码有效期 10 分钟，发送后邮箱会暂时锁定</view>
          </view>
          <view class="neo-btn-sm" bindtap="handleResetEmail">修改邮箱</view>
        </view>

        <!-- Code -->
        <view class="field-group">
          <view class="field-label-row">
            <text class="neo-label">📧 邮箱验证码</text>
          </view>
          <input class="neo-input" type="number" placeholder="请输入 6 位数字验证码" maxlength="6" data-field="code" bindinput="onInput" value="{{code}}"/>
          <view class="resend-row">
            <text class="resend-tip">{{cooldownSeconds > 0 ? '可在 ' + cooldownSeconds + ' 秒后重新发送' : '如果没收到，可以重新发送验证码'}}</text>
            <view class="neo-btn-sm {{(isSendingCode || cooldownSeconds > 0) ? 'btn-disabled' : ''}}" bindtap="handleSendCode">
              <text>{{isSendingCode ? '发送中…' : '重新发送'}}</text>
            </view>
          </view>
        </view>

        <!-- Display Name -->
        <view class="field-group">
          <view class="neo-label mb-1">👤 昵称 <text style="font-weight:400;font-size:12px;letter-spacing:0;">(可选)</text></view>
          <input class="neo-input" type="text" placeholder="不填则默认使用邮箱前缀" maxlength="120" data-field="displayName" bindinput="onInput" value="{{displayName}}"/>
        </view>

        <!-- Password -->
        <view class="field-group">
          <view class="neo-label mb-1">🔑 设置密码</view>
          <view class="input-row">
            <input class="neo-input flex-1" password="{{!showPassword}}" placeholder="至少 8 位" data-field="password" bindinput="onInput" value="{{password}}"/>
            <view class="toggle-btn" data-field="main" bindtap="togglePassword">
              <text>{{showPassword ? '🙈' : '👁'}}</text>
            </view>
          </view>
          <!-- Strength bar -->
          <view wx:if="{{password.length > 0}}" class="strength-wrap">
            <view class="strength-bars">
              <view wx:for="{{[1,2,3,4,5]}}" wx:key="index" class="strength-bar {{index < passwordStrength.score ? 'bar-filled' : 'bar-empty'}}" style="{{index < passwordStrength.score ? 'background:' + passwordStrength.color + ';' : ''}}"></view>
            </view>
            <text class="strength-label">密码强度：{{passwordStrength.label}}</text>
          </view>
        </view>

        <!-- Confirm Password -->
        <view class="field-group">
          <view class="neo-label mb-1">
            🔑 确认密码
            <text wx:if="{{passwordsMatch}}" class="match-badge"> ✓ 一致</text>
          </view>
          <view class="input-row">
            <input class="neo-input flex-1" password="{{!showConfirmPassword}}" placeholder="再次输入密码" data-field="confirmPassword" bindinput="onInput" value="{{confirmPassword}}"/>
            <view class="toggle-btn" data-field="confirm" bindtap="togglePassword">
              <text>{{showConfirmPassword ? '🙈' : '👁'}}</text>
            </view>
          </view>
          <text wx:if="{{passwordsMismatch}}" class="mismatch-text">两次输入的密码暂时不一致</text>
        </view>

        <view class="neo-btn w-full text-center {{isSubmitting ? 'btn-disabled' : ''}}" bindtap="handleRegister">
          <text>{{isSubmitting ? '正在完成注册…' : '完成注册 →'}}</text>
        </view>
      </block>

      <!-- Success message -->
      <view wx:if="{{successMessage}}" class="neo-success-box">
        <text>{{successMessage}}</text>
      </view>
      <!-- Error -->
      <view wx:if="{{error}}" class="neo-error-box">
        <text>{{error}}</text>
      </view>

      <!-- Login Link -->
      <view class="login-hint-card">
        <view>
          <view class="neo-label">已经有账号？</view>
          <view class="login-hint-text">直接用邮箱和密码登录就可以继续学习</view>
        </view>
        <view class="neo-btn-secondary" style="padding: 10px 16px; font-size: 13px;" bindtap="goToLogin">去登录 →</view>
      </view>
    </view>
  </view>
</view>
