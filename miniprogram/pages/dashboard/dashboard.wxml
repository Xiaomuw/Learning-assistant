<view class="dashboard-page">
  <!-- Loading -->
  <view wx:if="{{isLoading}}" class="center-state">
    <view class="neo-box state-card">
      <text class="state-label">Dashboard</text>
      <text class="state-title">正在恢复你的学习中心…</text>
    </view>
  </view>

  <block wx:else>
    <!-- Header -->
    <view class="dash-header">
      <view>
        <text class="header-label">Dashboard</text>
        <text class="header-title">学习中心</text>
        <text class="header-desc">这里不是"好不好看"的报表，而是你最近到底卡在哪、强在哪。</text>
      </view>
      <view class="header-badge">REPORT</view>
    </view>

    <scroll-view scroll-y="true" class="dash-scroll">
      <!-- Error -->
      <view wx:if="{{loadError}}" class="neo-box error-card">
        <text class="state-label">Memory</text>
        <text class="error-text">学习记忆暂时没有加载成功：{{loadError}}</text>
      </view>

      <!-- Stats Grid -->
      <view class="stats-grid">
        <view class="stat-card stat-secondary">
          <text class="stat-label">Recent</text>
          <text class="stat-num">{{memory.recent_topics.length}}</text>
          <text class="stat-sublabel">近期话题</text>
        </view>
        <view class="stat-card stat-accent">
          <text class="stat-label">Errors</text>
          <text class="stat-num">{{totalErrors}}</text>
          <text class="stat-sublabel">总错题数</text>
        </view>
        <view class="stat-card stat-default">
          <text class="stat-label">Weak Points</text>
          <text class="stat-num">{{memory.weak_points.length}}</text>
          <text class="stat-sublabel">薄弱点</text>
        </view>
        <view class="stat-card stat-muted">
          <text class="stat-label">Last Session</text>
          <text class="stat-num-sm">{{memory.last_session ? '已有记录' : '还没开始'}}</text>
        </view>
      </view>

      <!-- Mastery stats -->
      <view wx:if="{{mastery.length > 0}}" class="neo-box mastery-section">
        <text class="section-label">知识点掌握度</text>
        <view class="mastery-grid">
          <view class="mastery-item mastery-done">
            <text class="mastery-num">{{totalMastered}}</text>
            <text class="mastery-key">已掌握</text>
          </view>
          <view class="mastery-item mastery-learning">
            <text class="mastery-num">{{totalLearning}}</text>
            <text class="mastery-key">学习中</text>
          </view>
          <view class="mastery-item mastery-weak">
            <text class="mastery-num">{{totalWeak}}</text>
            <text class="mastery-key">薄弱点</text>
          </view>
        </view>
        <!-- Weak points list -->
        <view wx:if="{{memory.weak_points.length > 0}}" class="weak-list">
          <text class="field-label">薄弱点清单</text>
          <view wx:for="{{memory.weak_points}}" wx:key="index" class="weak-tag">
            <text>⚠️ {{item}}</text>
          </view>
        </view>
      </view>

      <!-- Recent Topics -->
      <view wx:if="{{memory.recent_topics.length > 0}}" class="neo-box topics-section">
        <text class="section-label">近期话题</text>
        <view class="topics-list">
          <view wx:for="{{memory.recent_topics}}" wx:key="index" class="topic-tag">{{item}}</view>
        </view>
      </view>

      <!-- Next Move -->
      <view class="neo-box next-card">
        <text class="section-label">⚡ Next Move</text>
        <text class="next-desc">
          {{memory.weak_points.length > 0
            ? '下一步最值得做的是：回到问答页，针对「' + memory.weak_points[0] + '」再让助手讲一遍，然后马上去刷题页练一次。'
            : '你还没有形成明显短板，建议挑一个新笔记本继续积累资料并开始提问。'}}
        </text>
        <view class="action-btns">
          <view class="neo-btn action-btn-primary" bindtap="goToChat">🧠 去问答页继续学</view>
          <view class="neo-btn action-btn-ghost" bindtap="goToPractice">✨ 去刷题页做题 →</view>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
