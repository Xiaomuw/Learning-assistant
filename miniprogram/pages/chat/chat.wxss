.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--neo-bg);
}

/* Header */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #fff;
  border-bottom: 3px solid var(--neo-ink);
  flex-shrink: 0;
}
.header-left { display: flex; align-items: center; gap: 10px; }
.notebook-tag {
  display: flex;
  align-items: center;
  gap: 6px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  padding: 6px 14px;
  background: var(--neo-secondary);
  box-shadow: 2px 2px 0px var(--neo-ink);
}
.notebook-icon { font-size: 14px; }
.notebook-name { font-size: 13px; font-weight: 900; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notebook-arrow { font-size: 10px; color: rgba(30,30,36,0.5); }
.new-chat-btn {
  border: 3px solid var(--neo-ink);
  border-radius: 8px;
  padding: 6px 12px;
  background: var(--neo-primary);
  box-shadow: 2px 2px 0px var(--neo-ink);
  font-size: 12px;
  font-weight: 900;
}

/* Notebook picker */
.notebook-picker {
  position: absolute;
  top: 60px;
  left: 16px;
  right: 16px;
  z-index: 100;
  background: #fff;
  border: 3px solid var(--neo-ink);
  border-radius: 12px;
  box-shadow: 5px 5px 0px var(--neo-ink);
  overflow: hidden;
}
.notebook-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-bottom: 2px solid rgba(30,30,36,0.1);
  font-weight: 700;
  font-size: 14px;
}
.notebook-item:last-child { border-bottom: none; }
.notebook-item-active { background: var(--neo-secondary); }
.notebook-item-icon { font-size: 16px; }
.notebook-item-name { font-weight: 700; }

/* Messages */
.message-list {
  flex: 1;
  padding: 16px;
}
.msg-row {
  display: flex;
  margin-bottom: 16px;
}
.msg-row-user { justify-content: flex-end; }
.msg-row-assistant { justify-content: flex-start; }
.msg-bubble {
  max-width: 80%;
  padding: 12px 16px;
  border: 3px solid var(--neo-ink);
  border-radius: 16px;
}
.bubble-user {
  background: var(--neo-accent);
  border-bottom-right-radius: 4px;
  box-shadow: 3px 3px 0px var(--neo-ink);
}
.bubble-assistant {
  background: #fff;
  border-bottom-left-radius: 4px;
  box-shadow: 4px 4px 0px var(--neo-ink);
}
.msg-text {
  font-size: 15px;
  font-weight: 500;
  line-height: 1.65;
  word-break: break-all;
}
.cursor-blink {
  animation: blink 0.8s step-end infinite;
  color: var(--neo-ink);
}
@keyframes blink { 50% { opacity: 0; } }

/* Input bar */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 12px 16px;
  background: #fff;
  border-top: 3px solid var(--neo-ink);
  flex-shrink: 0;
}
.msg-input {
  flex: 1;
  border: 3px solid var(--neo-ink);
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 15px;
  min-height: 50px;
  background: var(--neo-bg);
}
.send-btn {
  width: 50px;
  height: 50px;
  border: 3px solid var(--neo-ink);
  border-radius: 12px;
  background: var(--neo-primary);
  box-shadow: 3px 3px 0px var(--neo-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 900;
  flex-shrink: 0;
}
.send-btn-disabled {
  opacity: 0.5;
  box-shadow: 1px 1px 0px var(--neo-ink);
}

/* Status/thinking indicator */
.status-hint {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 0;
}
.status-dot-wrap {
  display: flex;
  gap: 4px;
  align-items: center;
}
.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--neo-ink);
  opacity: 0.4;
  animation: dotPulse 1.2s infinite;
}
.d1 { animation-delay: 0s; }
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }
@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}
.status-text {
  font-size: 12px;
  font-weight: 700;
  color: rgba(30,30,36,0.5);
  flex: 1;
}

/* Error bubble */
.bubble-error {
  background: var(--neo-accent);
  border-bottom-left-radius: 4px;
  box-shadow: 4px 4px 0px var(--neo-ink);
}

/* Textarea override */
.msg-input {
  flex: 1;
  border: 3px solid var(--neo-ink);
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 15px;
  min-height: 50px;
  max-height: 120px;
  background: var(--neo-bg);
  line-height: 1.5;
}

