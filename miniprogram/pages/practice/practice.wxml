<view class="practice-page">
  <!-- Loading -->
  <view wx:if="{{isLoading}}" class="center-state">
    <view class="neo-box state-card">
      <text class="neo-label block">Practice Mode</text>
      <text class="state-title">正在恢复你的练习空间…</text>
    </view>
  </view>

  <block wx:elif="{{!isLoading}}">
    <!-- Header -->
    <view class="practice-header">
      <view class="header-left">
        <text class="neo-label block" style="opacity:0.6;">Practice Mode</text>
        <text class="header-title">选择题练习</text>
      </view>
      <view class="header-badge rotate-3">
        {{quizList.length > 0 ? (currentIndex + 1) + '/' + quizList.length : 'EMPTY'}}
      </view>
    </view>

    <!-- Progress bar -->
    <view wx:if="{{quizList.length > 0}}" class="progress-track">
      <view class="progress-fill" style="width: {{(currentIndex + 1) / quizList.length * 100}}%;"></view>
    </view>

    <scroll-view scroll-y="true" class="practice-scroll">
      <!-- Empty State -->
      <view wx:if="{{quizList.length === 0}}" class="empty-wrap">
        <view class="neo-box state-card">
          <text class="neo-label block">No Quiz Yet</text>
          <text class="state-title">题包还是空的</text>
          <text class="state-desc">先回问答页让学习助手出题，或者去"我的"页领取推荐真题。</text>
          <view class="neo-btn w-full text-center mt-5" bindtap="goToChat">去问答页生成练习题 →</view>
        </view>
      </view>

      <!-- Quiz Card -->
      <view wx:else class="quiz-section">
        <!-- Meta info -->
        <view class="meta-row">
          <view class="meta-item bg-secondary">
            <text class="meta-label">知识点</text>
            <text class="meta-value">{{quizList[currentIndex].knowledge_point || '综合'}}</text>
          </view>
          <view class="meta-item bg-muted">
            <text class="meta-label">难度</text>
            <text class="meta-value">{{quizList[currentIndex].difficulty || '基础'}}</text>
          </view>
          <view class="meta-item bg-white">
            <text class="meta-label">进度</text>
            <text class="meta-value">{{currentIndex + 1}} / {{quizList.length}}</text>
          </view>
        </view>

        <!-- Question -->
        <view class="neo-box question-card">
          <view class="question-badges">
            <view class="q-badge q-badge-accent">{{quizList[currentIndex].difficulty || '基础'}}</view>
            <view class="q-badge q-badge-secondary">{{quizList[currentIndex].knowledge_point || '综合'}}</view>
          </view>
          <text class="question-text" user-select="true">{{quizList[currentIndex].question}}</text>

          <!-- Hint -->
          <view wx:if="{{quizList[currentIndex].hint}}" class="hint-section">
            <view class="hint-toggle" bindtap="toggleHint">
              <text>{{showHint ? '📖 收起提示' : '💡 查看提示'}}</text>
            </view>
            <view wx:if="{{showHint}}" class="hint-box animate-stamp-in">
              <text>{{quizList[currentIndex].hint}}</text>
            </view>
          </view>

          <!-- Options -->
          <view class="options-list">
            <view
              wx:for="{{quizList[currentIndex].options}}"
              wx:key="key"
              class="option-item {{!feedback ? (selectedOption === item.key ? 'option-selected' : 'option-default') : (item.key === feedback.correct_option ? 'option-correct' : (item.key === selectedOption && !feedback.is_correct ? 'option-wrong' : 'option-dimmed'))}}"
              data-key="{{item.key}}"
              bindtap="selectOption"
            >
              <view class="option-key-badge">{{item.key}}</view>
              <view class="option-body">
                <text class="option-text">{{item.text}}</text>
                <text wx:if="{{feedback && feedback.option_rationales[item.key]}}" class="option-rationale">{{feedback.option_rationales[item.key]}}</text>
              </view>
            </view>
          </view>

          <!-- Submit Error -->
          <view wx:if="{{submitError}}" class="neo-error-box mt-4">{{submitError}}</view>

          <!-- Feedback Block -->
          <view wx:if="{{feedback}}" class="feedback-section animate-stamp-in">
            <view class="feedback-hero {{feedback.is_correct ? 'feedback-correct' : 'feedback-wrong'}}">
              <view class="feedback-hero-icon">{{feedback.is_correct ? '🎉' : '🔍'}}</view>
              <view class="feedback-hero-body">
                <text class="neo-label block" style="opacity:0.6;">{{feedback.is_correct ? 'Nice Work' : 'Review'}}</text>
                <text class="feedback-title">{{feedback.is_correct ? '答对了，关键点抓得很稳' : '这题值得复盘一下'}}</text>
              </view>
            </view>

            <!-- Explanation -->
            <view class="neo-box explanation-card">
              <text class="neo-label block mb-2">💡 标准解析</text>
              <text class="explanation-text" user-select="true">{{feedback.explanation}}</text>
            </view>

            <!-- Mastery -->
            <view wx:if="{{feedback.mastery_evaluation}}" class="neo-box-muted mastery-card">
              <text class="neo-label block mb-2">掌握度判断</text>
              <text class="mastery-score">{{feedback.mastery_evaluation.mastery_level === 'mastered' ? '已掌握' : (feedback.mastery_evaluation.mastery_level === 'learning' ? '学习中' : '薄弱点')}} · {{feedback.mastery_evaluation.mastery_score}}分</text>
              <text class="explanation-text">{{feedback.personalized_feedback || feedback.mastery_evaluation.feedback}}</text>
            </view>
          </view>

          <!-- Action Buttons -->
          <view class="action-row">
            <view
              wx:if="{{!feedback}}"
              class="neo-btn w-full text-center {{(!selectedOption || isSubmitting) ? 'btn-disabled' : ''}}"
              bindtap="handleSubmit"
            >
              <text>{{isSubmitting ? '正在判题…' : '提交作答 →'}}</text>
            </view>
            <view wx:else class="neo-btn-secondary w-full text-center" bindtap="handleNext">
              <text>{{currentIndex >= quizList.length - 1 ? '练完了，回问答页继续 →' : '下一题 →'}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
