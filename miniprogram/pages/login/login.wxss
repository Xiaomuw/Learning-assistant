.page-bg {
  background-color: var(--neo-bg);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Hero Banner */
.hero {
  padding: 36px 20px 24px;
  border-bottom: 3px solid var(--neo-ink);
}

.hero-secondary { background-color: var(--neo-secondary, #ff9e80); }
.hero-accent    { background-color: var(--neo-accent, #b39ddb); }

.badge-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background: #fff;
  padding: 4px 12px;
  margin-bottom: 12px;
  box-shadow: 2px 2px 0px var(--neo-ink);
}
.badge-tag-text {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.hero-title {
  font-size: 28px;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: -0.02em;
}
.hero-subtitle {
  margin-top: 8px;
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 30, 36, 0.7);
  line-height: 1.6;
}

/* Form Section */
.form-section {
  padding: 20px 16px 40px;
}

.form-card {
  background: #fff;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Field */
.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.field-label {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}
.neo-input {
  border: 3px solid var(--neo-ink);
  border-radius: 8px;
  padding: 12px;
  height: 50px;
  font-size: 15px;
  background: #fff;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.flex-1 { flex: 1; }
.toggle-btn {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 8px;
  background: #fff;
  box-shadow: 2px 2px 0px var(--neo-ink);
  font-size: 18px;
}

/* Error Box */
.error-box {
  border: 3px solid var(--neo-ink);
  border-radius: 16px;
  padding: 12px;
  background-color: var(--neo-accent, #b39ddb);
  box-shadow: 3px 3px 0px var(--neo-ink);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.5;
}

/* Buttons */
.submit-btn {
  background-color: var(--neo-primary, #ffeb3b);
  font-size: 15px;
  padding: 16px;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0.05em;
}
.ghost-btn {
  background-color: #fff;
  font-size: 15px;
  padding: 16px;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0.05em;
}
.btn-disabled {
  opacity: 0.6;
}

/* Divider */
.divider {
  display: flex;
  align-items: center;
  gap: 12px;
}
.divider-line {
  flex: 1;
  height: 3px;
  background: rgba(30, 30, 36, 0.1);
}
.divider-text {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: rgba(30, 30, 36, 0.4);
}

/* Hint */
.hint-box {
  border: 3px dashed var(--neo-ink);
  border-radius: 20px;
  padding: 12px 16px;
  background-color: var(--neo-bg);
}
.hint-text {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 30, 36, 0.7);
  line-height: 1.6;
}
