.page-bg {
  background-color: var(--neo-bg);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ─── Hero Banner ─── */
.hero {
  position: relative;
  padding: 40px 20px 28px;
  border-bottom: 3px solid var(--neo-ink);
  overflow: hidden;
}

.bg-secondary { background-color: var(--neo-secondary); }
.bg-accent    { background-color: var(--neo-accent); }
.bg-muted     { background-color: var(--neo-muted); }

.hero-deco {
  position: absolute;
  font-size: 48px;
  opacity: 0.15;
  pointer-events: none;
}
.hero-deco-r { right: 16px; top: 12px; }
.hero-deco-l { left: 20px; top: 24px; font-size: 28px; }

.hero-inner {
  position: relative;
  z-index: 2;
}

.neo-badge-text {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero-title {
  font-size: 30px;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  margin-top: 8px;
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 41, 59, 0.7);
  line-height: 1.6;
}

/* ─── Form Section ─── */
.form-section {
  flex: 1;
  padding: 20px 16px 40px;
}

.form-card {
  background: var(--neo-white);
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ─── Field ─── */
.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.toggle-btn {
  width: 54px;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background: var(--neo-white);
  box-shadow: 2px 3px 0px 0px var(--neo-ink);
  font-size: 20px;
  flex-shrink: 0;
  transition: transform 100ms linear, box-shadow 100ms linear;
}
.toggle-btn:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}
