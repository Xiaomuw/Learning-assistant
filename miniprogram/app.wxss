/* ═══════════════════════════════════════════════════
   Learning Assistant · Mini Program
   Global Design Tokens — Neo-Brutalism
   Aligned with frontend/app/globals.css
   ═══════════════════════════════════════════════════ */

/* ─── Design Tokens ─── */
page {
  /* Colors — H5-aligned palette */
  --neo-bg: #FFFDF8;
  --neo-bg-darker: #f5f0e0;
  --neo-ink: #1e293b;
  --neo-accent: #ffb3c6;       /* Pastel pink — primary action */
  --neo-secondary: #fdf0b0;    /* Buttery yellow */
  --neo-muted: #c4b5fd;        /* Lavender */
  --neo-green: #a7f3d0;        /* Mint green — success */
  --neo-blue: #bfdbfe;         /* Baby blue */
  --neo-white: #ffffff;
  --neo-error: #ff5252;

  /* Shadow presets (hard offset, zero blur) */
  --shadow-sm: 3px 4px 0px 0px var(--neo-ink);
  --shadow-md: 4px 6px 0px 0px var(--neo-ink);
  --shadow-lg: 6px 8px 0px 0px var(--neo-ink);
  --shadow-xl: 8px 12px 0px 0px var(--neo-ink);

  /* Page baseline */
  background-color: var(--neo-bg);
  /* Grid + dot texture overlay — matches H5 body */
  background-image:
    linear-gradient(to right, rgba(30, 41, 59, 0.08) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(30, 41, 59, 0.08) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, rgba(30, 41, 59, 0.08) 1px, transparent 0);
  background-size: 28px 28px, 28px 28px, 18px 18px;

  color: var(--neo-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 16px;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, button, image, textarea {
  box-sizing: border-box;
}

/* ─── Component: Card ─── */
.neo-box {
  background-color: var(--neo-white);
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.neo-box-accent {
  background-color: var(--neo-accent);
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.neo-box-secondary {
  background-color: var(--neo-secondary);
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.neo-box-muted {
  background-color: var(--neo-muted);
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

/* ─── Component: Button (Primary) ─── */
.neo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background-color: var(--neo-accent);
  padding: 14px 24px;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--neo-ink);
  box-shadow: var(--shadow-sm);
  transition: transform 100ms linear, box-shadow 100ms linear;
}

.neo-btn:active {
  transform: translate(4px, 4px);
  box-shadow: none;
}

/* Button variants */
.neo-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background-color: var(--neo-secondary);
  padding: 14px 24px;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--neo-ink);
  box-shadow: var(--shadow-sm);
  transition: transform 100ms linear, box-shadow 100ms linear;
}

.neo-btn-secondary:active {
  transform: translate(4px, 4px);
  box-shadow: none;
}

.neo-btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background-color: var(--neo-white);
  padding: 14px 24px;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--neo-ink);
  box-shadow: var(--shadow-sm);
  transition: transform 100ms linear, box-shadow 100ms linear;
}

.neo-btn-ghost:active {
  transform: translate(4px, 4px);
  box-shadow: none;
}

.neo-btn-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background-color: var(--neo-accent);
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: var(--neo-ink);
  box-shadow: 2px 3px 0px 0px var(--neo-ink);
  transition: transform 100ms linear, box-shadow 100ms linear;
}

.neo-btn-sm:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ─── Component: Input ─── */
.neo-input {
  width: 100%;
  border: 3px solid var(--neo-ink);
  border-radius: 32rpx;
  padding: 14px 16px;
  height: 54px;
  font-size: 15px;
  font-weight: 700;
  background-color: var(--neo-white);
  color: var(--neo-ink);
  box-shadow: var(--shadow-sm);
}

.neo-input-focus {
  background-color: var(--neo-secondary) !important;
}

/* ─── Component: Badge ─── */
.neo-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 3px solid var(--neo-ink);
  border-radius: 999px;
  background-color: var(--neo-secondary);
  padding: 5px 14px;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--neo-ink);
  box-shadow: 2px 3px 0px 0px var(--neo-ink);
}

/* ─── Component: Label ─── */
.neo-label {
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--neo-ink);
}

/* ─── Component: Divider ─── */
.neo-divider {
  display: flex;
  align-items: center;
  gap: 12px;
}
.neo-divider-line {
  flex: 1;
  height: 3px;
  background: rgba(30, 41, 59, 0.1);
}
.neo-divider-text {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: rgba(30, 41, 59, 0.4);
  text-transform: uppercase;
}

/* ─── Component: Hint Box ─── */
.neo-hint {
  border: 3px dashed var(--neo-ink);
  border-radius: 24rpx;
  background-color: var(--neo-bg);
  padding: 14px 18px;
}
.neo-hint text {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 41, 59, 0.7);
  line-height: 1.6;
}

/* ─── Component: Error / Success Box ─── */
.neo-error-box {
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  background-color: var(--neo-accent);
  padding: 14px;
  box-shadow: var(--shadow-sm);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.5;
  animation: stampIn 0.2s ease-out;
}

.neo-success-box {
  border: 3px solid var(--neo-ink);
  border-radius: 24rpx;
  background-color: var(--neo-green);
  padding: 14px;
  box-shadow: var(--shadow-sm);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.5;
  animation: stampIn 0.2s ease-out;
}

/* ─── Layout: Container ─── */
.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
}

/* ─── Animations ─── */
@keyframes stampIn {
  0% {
    opacity: 0;
    transform: translateY(14px) rotate(-2deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }
}

@keyframes floatTag {
  0%, 100% { transform: rotate(-3deg) translateY(0); }
  50% { transform: rotate(1deg) translateY(-3px); }
}

@keyframes pulseDot {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-3px); opacity: 1; }
}

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

@keyframes spinSlow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes blink {
  50% { opacity: 0; }
}

/* Animation classes */
.animate-stamp-in { animation: stampIn 0.2s ease-out; }
.animate-float-tag { animation: floatTag 2.8s ease-in-out infinite; }
.animate-pulse-dot { animation: pulseDot 1s linear infinite; }
.animate-spin-slow { animation: spinSlow 10s linear infinite; }

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .animate-stamp-in,
  .animate-float-tag,
  .animate-pulse-dot,
  .animate-spin-slow {
    animation: none;
  }
}

